@page "/sharayet"
@model NurSite.Web.Pages.SharayetModel
@{
    ViewData["Title"] = "شرایط استفاده";
    ViewData["MetaDescription"] = "شرایط استفاده از محتوای سایت مؤسسه فرهنگی نورالثقلین و قواعد بازنشر آن.";
}

<section class="tone-2 girih page-head">
    <div class="wrap">
        <nav class="crumbs" aria-label="مسیر صفحه">
            <a asp-page="/Index">خانه</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">شرایط استفاده</span>
        </nav>
        <h1>شرایط استفاده</h1>
        <p>آخرین به‌روزرسانی: <persian-date value="@Model.UpdatedAtUtc" /></p>
    </div>
</section>

<article class="tone-1">
    <div class="wrap article-body" style="max-width:760px">

        <h2>استفاده از محتوا</h2>
        <p>
            محتوای این سایت — مقالات، پاسخ‌های شرعی، سخنرانی‌ها، مداحی‌ها، پوسترها
            و کلیپ‌ها — برای استفاده و بازنشر شما منتشر شده است. می‌توانید آن‌ها را
            دانلود کنید، در شبکه‌های اجتماعی بگذارید، چاپ کنید یا در جلسات پخش کنید.
        </p>
        <p>
            تنها درخواست ما دو چیز است: نام وبسایت ما به‌عنوان منبع ذکر شود، و محتوا
            به شکلی تغییر نکند که معنایش عوض شود. بریدن بخشی از یک پاسخ شرعی که
            حکم را وارونه نشان بدهد، یا افزودن متن به پوستری که به نام ما منتشر
            می‌شود، از این جنس است.
        </p>
        <p>
            استفاده تجاری — فروش محتوا یا استفاده از آن در محصولی که فروخته می‌شود —
            نیاز به اجازه کتبی دارد. از <a asp-page="/Tamas">صفحه تماس</a> بپرسید.
        </p>

        <h2>درباره پاسخ‌های شرعی</h2>
        <p>
            پاسخ‌های بخش احکام بر اساس فتاوای مراجع تقلید تنظیم شده و در هر پاسخ،
            مرجع و منبع آن ذکر می‌شود. این پاسخ‌ها جای مراجعه به دفتر مرجع تقلید
            شما را نمی‌گیرند، به‌ویژه در مسائل خاص یا موردی.
        </p>
        <p>
            پیش از عمل به حکمی که در اینجا خوانده‌اید، مطمئن شوید مرجع ذکرشده همان
            مرجع تقلید شماست. در مسائل مالی، خانوادگی یا هر موضوعی که جزئیاتش
            می‌تواند حکم را عوض کند، پرسش مستقیم بهتر از تکیه بر متن عمومی است.
        </p>

        <h2>پرسش شرعی</h2>
        <p>
            پرسش‌ها را در نوبت پاسخ می‌دهیم و زمان مشخصی تضمین نمی‌شود. اگر هنگام
            ارسال اجازه انتشار داده باشید، ممکن است پرسش و پاسخ در آرشیو عمومی
            منتشر شود — بدون نام و شماره شما.
        </p>
        <p>
            پرسشی که توهین‌آمیز باشد، یا موضوعش شرعی نباشد، بی‌پاسخ می‌ماند.
        </p>

        <h2>اوقات شرعی</h2>
        <p>
            اوقات شرعی بر اساس محاسبات نجومی و افق شهر انتخابی شما محاسبه می‌شود و
            ممکن است با تقویم‌های دیگر چند دقیقه اختلاف داشته باشد. در مواردی که
            دقیقه‌ها مهم‌اند — مانند لحظه افطار — احتیاط کنید.
        </p>

        <h2>در دسترس بودن سایت</h2>
        <p>
            تلاش می‌کنیم سایت همیشه در دسترس باشد، ولی ممکن است برای به‌روزرسانی یا
            به دلیل مشکل فنی موقتاً از کار بیفتد. مسئولیتی بابت زیانی که از در
            دسترس نبودن سایت پیش بیاید بر عهده نمی‌گیریم.
        </p>

        <h2>تغییر این شرایط</h2>
        <p>
            این متن ممکن است به‌روز شود. تاریخ بالای صفحه، آخرین بازنگری را نشان می‌دهد.
        </p>
    </div>
</article>
