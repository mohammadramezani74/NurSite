@page "/offline"
@{
    ViewData["Title"] = "بدون اتصال به اینترنت";
    ViewData["MetaDescription"] = "این صفحه نیاز به اتصال اینترنت دارد.";
}
<section class="tone-1">
    <div class="wrap" style="text-align:center;max-width:620px">
        <div class="sec-head center">
            <span class="kicker">اتصال برقرار نیست</span>
            <h2>الان به اینترنت وصل نیستید</h2>
            <p>صفحاتی که قبلاً باز کرده‌اید همچنان در دسترس هستند. برای دیدن محتوای تازه، اتصال خود را بررسی کنید.</p>
        </div>
        <a href="/" class="btn btn-gold">تلاش دوباره</a>
    </div>
</section>
