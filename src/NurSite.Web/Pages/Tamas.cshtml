@page "/tamas"
@model TamasModel
@{
    ViewData["Title"] = "تماس با ما";
    ViewData["MetaDescription"] = "نشانی، تلفن و فرم تماس با مؤسسه فرهنگی نورالثقلین.";
}

@section Head {
    <json-ld data="@Model.BuildOrganizationSchema()" />
}

<section class="tone-2 girih page-head">
    <div class="wrap">
        <nav class="crumbs" aria-label="مسیر صفحه">
            <a asp-page="/Index">خانه</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">تماس با ما</span>
        </nav>
        <h1>تماس با ما</h1>
        <p>پرسش، پیشنهاد یا انتقادی دارید؟ برایمان بنویسید.</p>
    </div>
</section>

<section class="tone-1">
    <div class="wrap contact-cols">

        @* ---------- اطلاعات تماس ---------- *@
        <aside class="contact-info">
            @if (!string.IsNullOrWhiteSpace(Model.Settings?.ContactAddress))
            {
                <div class="info-item">
                    <span class="info-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                    </span>
                    <div>
                        <h2>نشانی</h2>
                        <p>@Model.Settings.ContactAddress</p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Settings?.ContactPhone))
            {
                <div class="info-item">
                    <span class="info-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
                    </span>
                    <div>
                        <h2>تلفن</h2>
                        <p><a href="tel:@Model.Settings.ContactPhone.Replace(" ", "").Replace("-", "")" dir="ltr">@Model.Settings.ContactPhone</a></p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Settings?.ContactEmail))
            {
                <div class="info-item">
                    <span class="info-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                    </span>
                    <div>
                        <h2>رایانامه</h2>
                        <p><a href="mailto:@Model.Settings.ContactEmail" dir="ltr">@Model.Settings.ContactEmail</a></p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Settings?.WorkingHours))
            {
                <div class="info-item">
                    <span class="info-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                    </span>
                    <div>
                        <h2>ساعات کاری</h2>
                        <p>@Model.Settings.WorkingHours</p>
                    </div>
                </div>
            }

            @{
                var telegram = Model.Settings?.TelegramUrl;
                var instagram = Model.Settings?.InstagramUrl;
                var aparat = Model.Settings?.AparatUrl;
            }
            @if (!string.IsNullOrWhiteSpace(telegram) || !string.IsNullOrWhiteSpace(instagram) || !string.IsNullOrWhiteSpace(aparat))
            {
                <div class="info-item">
                    <span class="info-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" /></svg>
                    </span>
                    <div>
                        <h2>شبکه‌های اجتماعی</h2>
                        <p class="social-row">
                            @if (!string.IsNullOrWhiteSpace(telegram))
                            {
                                <a href="@telegram" target="_blank" rel="noopener noreferrer">تلگرام</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(instagram))
                            {
                                <a href="@instagram" target="_blank" rel="noopener noreferrer">اینستاگرام</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(aparat))
                            {
                                <a href="@aparat" target="_blank" rel="noopener noreferrer">آپارات</a>
                            }
                        </p>
                    </div>
                </div>
            }

            <div class="contact-hint">
                <p>
                    اگر <strong>پرسش شرعی</strong> دارید، از
                    <a asp-page="/Porsesh">فرم پرسش شرعی</a>
                    استفاده کنید تا سریع‌تر پاسخ بگیرید.
                </p>
            </div>
        </aside>

        @* ---------- فرم ---------- *@
        <div class="contact-form-col">
            @if (Model.Sent)
            {
                <div class="code-box" role="status">
                    <span class="code-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                    <h2>پیام شما رسید</h2>
                    <p>در اولین فرصت بررسی می‌شود و در صورت نیاز با شما تماس می‌گیریم.</p>
                    <p style="margin-top:22px">
                        <a asp-page="/Tamas" class="btn btn-ghost">ارسال پیام دیگر</a>
                    </p>
                </div>
            }
            else
            {
                <form method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                    <div class="field">
                        <label asp-for="Input.SenderName" class="label">نام</label>
                        <input asp-for="Input.SenderName" class="input input-plain" autocomplete="name" />
                        <span asp-validation-for="Input.SenderName" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.SenderMobile" class="label">شماره موبایل</label>
                        <input asp-for="Input.SenderMobile" class="input input-plain" type="tel"
                               inputmode="numeric" dir="ltr" placeholder="۰۹۱۲۳۴۵۶۷۸۹"
                               autocomplete="tel" data-persian-digits />
                        <span asp-validation-for="Input.SenderMobile" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.SenderEmail" class="label">
                            رایانامه
                            <span class="label-hint">اختیاری</span>
                        </label>
                        <input asp-for="Input.SenderEmail" class="input input-plain" type="email"
                               dir="ltr" autocomplete="email" />
                        <span asp-validation-for="Input.SenderEmail" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Subject" class="label">
                            موضوع
                            <span class="label-hint">اختیاری</span>
                        </label>
                        <input asp-for="Input.Subject" class="input input-plain" />
                    </div>

                    <div class="field">
                        <label asp-for="Input.Body" class="label">پیام</label>
                        <textarea asp-for="Input.Body" class="input input-plain" rows="7"
                                  maxlength="4000" data-counter="bodyCount"></textarea>
                        <span class="counter"><span id="bodyCount">۰</span> از ۴۰۰۰</span>
                        <span asp-validation-for="Input.Body" class="field-error"></span>
                    </div>

                    @* تله هرزنامه *@
                    <div class="hp-field" aria-hidden="true">
                        <label for="Input_Website">این فیلد را خالی بگذارید</label>
                        <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
                    </div>

                    <button type="submit" class="btn btn-gold auth-submit">ارسال پیام</button>

                    <p class="auth-note" style="text-align:start">
                        شماره موبایل شما فقط برای پاسخ استفاده می‌شود و در سایت نمایش داده نمی‌شود.
                    </p>
                </form>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true" defer></script>
    <script src="~/js/article-editor.js" asp-append-version="true" defer></script>
}
