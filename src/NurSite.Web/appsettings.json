{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=NurSite;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "SeedOnStartup": false,
  "Seed": {
    "AdminMobile": "",
    "AdminPassword": ""
  },
  "AllowedHosts": "*",
  "Upload": {
    "MaxBytes": 3145728,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".gif"
    ],
    "Audio": {
      "MaxBytes": 62914560,
      "AllowedExtensions": [
        ".mp3"
      ]
    },
    "Video": {
      "MaxBytes": 104857600,
      "AllowedExtensions": [
        ".mp4",
        ".webm"
      ]
    }
  },
  "Sms": {
    "ApiKey": "xxx",
    "VerifyTemplateId": 721930,
    "CodeParameterName": "CODE",
    "LineNumber": "30002108032421",
    "UseFakeSender": false
  },
  "LoginCode": {
    "Digits": 5,
    "LifetimeSeconds": 180,
    "ResendCooldownSeconds": 60,
    "MaxPerHourPerMobile": 5,
    "MaxPerHourPerIp": 15,
    "MaxAttempts": 5
  }
}