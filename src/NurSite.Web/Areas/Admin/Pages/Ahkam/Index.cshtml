@page
@model NurSite.Web.Areas.Admin.Pages.Ahkam.IndexModel
@{
    ViewData["Title"] = "احکام";
    ViewData["Subtitle"] = "پرسش و پاسخ‌های شرعی منتشرشده";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

@if (Model.Categories.Count == 0)
{
    <div class="flash flash-warn">
        هنوز بابی برای احکام تعریف نشده است.
        <a asp-area="Admin" asp-page="/Abvab/Index">اول ابواب را بسازید</a>.
    </div>
}

<section class="panel">
    <header class="panel-head">
        <h2>فهرست احکام <span class="count"><fa-num>@Model.TotalCount</fa-num></span></h2>
        <a asp-page="./Edit" class="btn btn-gold btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px"><path d="M12 5v14M5 12h14" /></svg>
            حکم تازه
        </a>
    </header>

    <form method="get" class="filter-bar">
        <div class="filter-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <label class="sr" for="q">جستجو در پرسش و پاسخ</label>
            <input id="q" name="q" value="@Model.Q" placeholder="جستجو در متن پرسش و پاسخ…" />
        </div>

        <label class="sr" for="categoryId">باب</label>
        <select id="categoryId" name="categoryId" class="filter-select">
            <option value="">همه ابواب</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Title</option>
            }
        </select>

        <label class="sr" for="marjaId">مرجع</label>
        <select id="marjaId" name="marjaId" class="filter-select">
            <option value="">همه مراجع</option>
            @foreach (var m in Model.Marjas)
            {
                <option value="@m.Id" selected="@(Model.MarjaId == m.Id)">@m.FullName</option>
            }
        </select>

        <label class="sr" for="status">وضعیت</label>
        <select id="status" name="status" class="filter-select">
            <option value="">همه وضعیت‌ها</option>
            <option value="@((int)PublishStatus.Draft)" selected="@(Model.Status == PublishStatus.Draft)">پیش‌نویس</option>
            <option value="@((int)PublishStatus.Published)" selected="@(Model.Status == PublishStatus.Published)">منتشرشده</option>
        </select>

        <label class="checkbox">
            <input type="checkbox" name="faq" value="true" checked="@(Model.Faq == true)" />
            <span>فقط پرتکرارها</span>
        </label>

        <label class="checkbox">
            <input type="checkbox" name="diagram" value="true" checked="@(Model.Diagram == true)" />
            <span>فقط نموداری‌ها</span>
        </label>

        <button type="submit" class="btn btn-ghost btn-sm">اعمال</button>
        @if (!string.IsNullOrWhiteSpace(Model.Q) || Model.Status is not null || Model.CategoryId is not null || Model.MarjaId is not null || Model.Faq == true || Model.Diagram == true)
        {
            <a asp-page="./Index" class="link-quiet">حذف فیلترها</a>
        }
    </form>

    @if (Model.Rulings.Count == 0)
    {
        <p class="empty">
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <span>نتیجه‌ای برای «@Model.Q» پیدا نشد.</span>
            }
            else
            {
                <span>هنوز حکمی ثبت نشده است.</span>
            }
        </p>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>پرسش</th>
                        <th>باب</th>
                        <th>مرجع</th>
                        <th>وضعیت</th>
                        <th class="cell-actions">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rulings)
                    {
                        <tr>
                            <td class="cell-title">
                                <a asp-page="./Edit" asp-route-id="@r.Id">@r.Question</a>
                                <span class="cell-slug">/ahkam/@r.Slug</span>
                            </td>
                            <td>@r.RulingCategory.Title</td>
                            <td>
                                @if (r.Marja is not null)
                                {
                                    <span>@r.Marja.FullName</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(r.FatwaNote))
                                {
                                    <span class="muted-cell">@r.FatwaNote</span>
                                }
                                else
                                {
                                    <span class="seo-dot miss">بدون استناد</span>
                                }
                            </td>
                            <td>
                                @if (r.Status == PublishStatus.Published)
                                {
                                    <span class="badge badge-ok">منتشرشده</span>
                                }
                                else
                                {
                                    <span class="badge badge-draft">پیش‌نویس</span>
                                }
                                @if (r.IsFrequentlyAsked)
                                {
                                    <span class="badge badge-wait">پرتکرار</span>
                                }
                                @if (r.HasDiagram)
                                {
                                    <span class="badge badge-diagram">نموداری</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="actions">
                                    <a asp-page="./Edit" asp-route-id="@r.Id" class="icon-btn" title="ویرایش">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                    </a>

                                    <a asp-page="./Nemodar" asp-route-id="@r.Id"
                                       class="icon-btn @(r.HasDiagram ? "on" : "")"
                                       title="@(r.HasDiagram ? "ویرایش نمودار شرطی" : "افزودن نمودار شرطی")">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v4M12 7H6v4M12 7h6v4M6 11v0M18 11v0" /><rect x="9" y="1" width="6" height="4" rx="1" /><rect x="3" y="11" width="6" height="4" rx="1" /><rect x="15" y="11" width="6" height="4" rx="1" /></svg>
                                    </a>

                                    <form method="post" asp-page-handler="Faq" asp-route-id="@r.Id" asp-route-q="@Model.Q" asp-route-page="@Model.PageNumber">
                                        <button type="submit" class="icon-btn @(r.IsFrequentlyAsked ? "on" : "")"
                                                title="@(r.IsFrequentlyAsked ? "برداشتن از احکام پرتکرار" : "افزودن به احکام پرتکرار")">
                                            <svg viewBox="0 0 24 24" fill="@(r.IsFrequentlyAsked ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.8"><path d="m12 3 2.7 5.8 6.3.8-4.6 4.4 1.2 6.3L12 17.3 6.4 20.3l1.2-6.3L3 9.6l6.3-.8Z" /></svg>
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@r.Id" asp-route-q="@Model.Q" asp-route-page="@Model.PageNumber">
                                        <button type="submit" class="icon-btn"
                                                title="@(r.Status == PublishStatus.Published ? "برگرداندن به پیش‌نویس" : "انتشار")">
                                            @if (r.Status == PublishStatus.Published)
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.6-7 10-7c2 0 3.7.7 5.1 1.6M22 12s-3.6 7-10 7c-2 0-3.7-.7-5.1-1.6" /><path d="M3 3l18 18" /></svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6 9 17l-5-5" /></svg>
                                            }
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" asp-route-q="@Model.Q" asp-route-page="@Model.PageNumber"
                                          data-confirm="این حکم حذف شود؟">
                                        <button type="submit" class="icon-btn danger" title="حذف">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pager" aria-label="صفحه‌بندی">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-page="./Index" asp-route-q="@Model.Q" asp-route-status="@Model.Status"
                       asp-route-categoryId="@Model.CategoryId" asp-route-marjaId="@Model.MarjaId"
                       asp-route-faq="@Model.Faq" asp-route-diagram="@Model.Diagram" asp-route-page="@p"
                       class="pager-item @(p == Model.PageNumber ? "on" : "")"
                       aria-current="@(p == Model.PageNumber ? "page" : null)">
                        <fa-num>@p</fa-num>
                    </a>
                }
            </nav>
        }
    }
</section>
