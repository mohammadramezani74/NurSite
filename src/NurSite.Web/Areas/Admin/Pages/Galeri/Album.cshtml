@page "{id:int}"
@using NurSite.Application.Services
@model NurSite.Web.Areas.Admin.Pages.Galeri.AlbumModel
@{
    ViewData["Title"] = Model.Album.Title;
    ViewData["Subtitle"] = "محتوای آلبوم";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

<p style="margin-bottom:1rem">
    <a asp-page="./Index" class="link-quiet">→ بازگشت به آلبوم‌ها</a>
    @if (Model.Album.Status != PublishStatus.Published)
    {
        <span class="badge badge-draft" style="margin-inline-start:.5rem">این آلبوم منتشر نشده است</span>
    }
</p>

<section class="panel">
    <header class="panel-head">
        <h2>افزودن محتوا</h2>
        <span class="panel-hint">چند فایل را با هم انتخاب کنید</span>
    </header>
    <div class="panel-body">
        <form method="post" asp-page-handler="Upload" asp-route-id="@Model.Album.Id"
              enctype="multipart/form-data">
            <div class="field">
                <label asp-for="UploadKind" class="label">نوع</label>
                <select asp-for="UploadKind" class="input input-plain">
                    @foreach (var k in MediaKinds.All)
                    {
                        <option value="@k">@MediaKinds.Label(k) — @MediaKinds.AspectHint(k)</option>
                    }
                </select>
                <span class="label-hint">برای همه فایل‌های این آپلود اعمال می‌شود و بعد تک‌تک قابل تغییر است</span>
            </div>

            <div class="field">
                <label asp-for="Files" class="label">
                    فایل‌های تصویری
                    <span class="label-hint">عنوان هر کدام از نام فایل ساخته می‌شود</span>
                </label>
                <input asp-for="Files" type="file" accept="image/*" multiple class="input input-plain" />
            </div>

            <button type="submit" class="btn btn-gold">آپلود</button>
        </form>
    </div>
</section>

@if (Model.Item.Id != 0)
{
    <section class="panel">
        <header class="panel-head">
            <h2>ویرایش قلم</h2>
            <a asp-page="./Album" asp-route-id="@Model.Album.Id" class="link-quiet">انصراف</a>
        </header>
        <div class="panel-body">
            <form method="post" asp-page-handler="SaveItem" asp-route-id="@Model.Album.Id"
                  enctype="multipart/form-data">
                <input type="hidden" asp-for="Item.Id" />
                <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                <div class="field">
                    <label asp-for="Item.Title" class="label">عنوان</label>
                    <input asp-for="Item.Title" class="input input-plain"
                           placeholder="مثلاً: پوستر شهادت امام حسین علیه‌السلام" />
                    <span asp-validation-for="Item.Title" class="field-error"></span>
                    <span class="label-hint">همان چیزی که کاربر در گوگل جستجو می‌کند</span>
                </div>

                <div class="field">
                    <label asp-for="Item.Kind" class="label">نوع</label>
                    <select asp-for="Item.Kind" class="input input-plain">
                        @foreach (var k in MediaKinds.All)
                        {
                            <option value="@k">@MediaKinds.Label(k)</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label asp-for="Item.AltText" class="label">
                        متن جایگزین
                        <span class="label-hint">برای نابینایان و برای جستجوی تصویر گوگل</span>
                    </label>
                    <input asp-for="Item.AltText" class="input input-plain" />
                    <span asp-validation-for="Item.AltText" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Item.Caption" class="label">توضیح</label>
                    <textarea asp-for="Item.Caption" class="input input-plain" rows="2"></textarea>
                    <span asp-validation-for="Item.Caption" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="VideoFile" class="label">
                        فایل ویدیو
                        <span class="label-hint">فقط برای کلیپ؛ تصویر بالا کاور آن می‌شود</span>
                    </label>
                    <input asp-for="VideoFile" type="file" accept="video/mp4,video/webm" class="input input-plain" />
                    <span asp-validation-for="VideoFile" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Item.ExternalVideoUrl" class="label">
                        یا لینک ویدیو
                        <span class="label-hint">آپارات یا هر جای دیگر؛ جایگزین فایل بالا می‌شود</span>
                    </label>
                    <input asp-for="Item.ExternalVideoUrl" class="input input-plain" dir="ltr" placeholder="https://" />
                    <span asp-validation-for="Item.ExternalVideoUrl" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-gold">ذخیره</button>
            </form>
        </div>
    </section>
}

<section class="panel">
    <header class="panel-head">
        <h2>محتوای آلبوم <span class="count"><fa-num>@Model.Items.Count</fa-num></span></h2>
    </header>

    @if (Model.Items.Count == 0)
    {
        <p class="empty">این آلبوم هنوز خالی است.</p>
    }
    else
    {
        <div class="panel-body">
            <div class="media-grid">
                @foreach (var item in Model.Items)
                {
                    <figure class="media-cell">
                        <img src="@item.FilePath" alt="@item.AltText"
                             width="@(item.Width > 0 ? item.Width : 400)"
                             height="@(item.Height > 0 ? item.Height : 400)"
                             loading="lazy" decoding="async">

                        <figcaption>
                            <b>@item.Title</b>
                            <span class="media-meta">
                                <span class="badge">@MediaKinds.Label(item.Kind)</span>
                                @if (item.Width > 0)
                                {
                                    <span><fa-num>@item.Width</fa-num>×<fa-num>@item.Height</fa-num></span>
                                }
                                @if (item.FileSizeBytes > 0)
                                {
                                    <span><fa-num>@MediaKinds.FormatSize(item.FileSizeBytes)</fa-num></span>
                                }
                                @if (item.HasVideo)
                                {
                                    <span class="badge badge-ok">@(item.IsExternalVideo ? "ویدیو بیرونی" : "ویدیو")</span>
                                }
                            </span>
                        </figcaption>

                        <div class="media-actions">
                            <form method="post" asp-page-handler="Move" asp-route-id="@Model.Album.Id"
                                  asp-route-itemId="@item.Id" asp-route-direction="up">
                                <button type="submit" class="icon-btn" title="بالاتر">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 15 6-6 6 6" /></svg>
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Move" asp-route-id="@Model.Album.Id"
                                  asp-route-itemId="@item.Id" asp-route-direction="down">
                                <button type="submit" class="icon-btn" title="پایین‌تر">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 9 6 6 6-6" /></svg>
                                </button>
                            </form>
                            <a asp-page="./Album" asp-route-id="@Model.Album.Id" asp-route-edit="@item.Id"
                               class="icon-btn" title="ویرایش">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                            </a>
                            <form method="post" asp-page-handler="DeleteItem" asp-route-id="@Model.Album.Id"
                                  asp-route-itemId="@item.Id" data-confirm="«@item.Title» حذف شود؟">
                                <button type="submit" class="icon-btn danger" title="حذف">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                </button>
                            </form>
                        </div>
                    </figure>
                }
            </div>
        </div>
    }
</section>
