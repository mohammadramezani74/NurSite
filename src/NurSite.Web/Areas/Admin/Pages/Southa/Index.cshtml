@page
@using NurSite.Application.Services
@model NurSite.Web.Areas.Admin.Pages.Southa.IndexModel
@{
    ViewData["Title"] = "صوت‌ها";
    ViewData["Subtitle"] = "سخنرانی، مداحی و سرود مذهبی";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

@if (Model.Speakers.Count == 0)
{
    <div class="flash flash-warn">
        هنوز گوینده‌ای ثبت نشده است. صوت بدون گوینده هم منتشر می‌شود، ولی
        <a asp-area="Admin" asp-page="/Sokhanranan/Index">بهتر است اول سخنرانان و مداحان را بسازید</a>.
    </div>
}

<section class="panel">
    <header class="panel-head">
        <h2>فهرست صوت‌ها <span class="count"><fa-num>@Model.TotalCount</fa-num></span></h2>
        <a asp-page="./Edit" class="btn btn-gold btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px"><path d="M12 5v14M5 12h14" /></svg>
            صوت تازه
        </a>
    </header>

    <form method="get" class="filter-bar">
        <div class="filter-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <label class="sr" for="q">جستجو در عنوان و توضیح</label>
            <input id="q" name="q" value="@Model.Q" placeholder="جستجو در عنوان و توضیح…" />
        </div>

        <label class="sr" for="kind">نوع</label>
        <select id="kind" name="kind" class="filter-select">
            <option value="">همه انواع</option>
            @foreach (var k in AudioKinds.All)
            {
                <option value="@((int)k)" selected="@(Model.Kind == k)">@AudioKinds.PluralLabel(k)</option>
            }
        </select>

        <label class="sr" for="speakerId">گوینده</label>
        <select id="speakerId" name="speakerId" class="filter-select">
            <option value="">همه گویندگان</option>
            @foreach (var s in Model.Speakers)
            {
                <option value="@s.Id" selected="@(Model.SpeakerId == s.Id)">@s.FullName</option>
            }
        </select>

        <label class="sr" for="seriesId">مجموعه</label>
        <select id="seriesId" name="seriesId" class="filter-select">
            <option value="">همه مجموعه‌ها</option>
            @foreach (var s in Model.SeriesList)
            {
                <option value="@s.Id" selected="@(Model.SeriesId == s.Id)">@s.Title</option>
            }
        </select>

        <label class="sr" for="status">وضعیت</label>
        <select id="status" name="status" class="filter-select">
            <option value="">همه وضعیت‌ها</option>
            <option value="@((int)PublishStatus.Draft)" selected="@(Model.Status == PublishStatus.Draft)">پیش‌نویس</option>
            <option value="@((int)PublishStatus.Published)" selected="@(Model.Status == PublishStatus.Published)">منتشرشده</option>
            <option value="@((int)PublishStatus.Archived)" selected="@(Model.Status == PublishStatus.Archived)">بایگانی</option>
        </select>

        <button type="submit" class="btn btn-ghost btn-sm">اعمال</button>
        @if (!string.IsNullOrWhiteSpace(Model.Q) || Model.Kind is not null || Model.Status is not null
                || Model.SpeakerId is not null || Model.SeriesId is not null)
        {
            <a asp-page="./Index" class="link-quiet">حذف فیلترها</a>
        }
    </form>

    @if (Model.Items.Count == 0)
    {
        <p class="empty">
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <span>نتیجه‌ای برای «@Model.Q» پیدا نشد.</span>
            }
            else
            {
                <span>هنوز صوتی ثبت نشده است. با دکمه «صوت تازه» شروع کنید.</span>
            }
        </p>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>عنوان</th>
                        <th>نوع</th>
                        <th>گوینده</th>
                        <th>مدت</th>
                        <th>وضعیت</th>
                        <th class="cell-actions">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="cell-title">
                                <a asp-page="./Edit" asp-route-id="@item.Id">@item.Title</a>
                                <span class="cell-slug">
                                    @if (item.LectureSeries is not null)
                                    {
                                        <text>@item.LectureSeries.Title</text>
                                        @if (item.EpisodeNumber is not null)
                                        {
                                            <text> · جلسه <fa-num>@item.EpisodeNumber</fa-num></text>
                                        }
                                        <text> · </text>
                                    }
                                    @AudioKinds.Url(item.Kind, item.Slug)
                                </span>
                            </td>
                            <td><span class="badge">@AudioKinds.Label(item.Kind)</span></td>
                            <td>
                                @if (item.Speaker is not null)
                                {
                                    <span>@item.Speaker.FullName</span>
                                }
                                else
                                {
                                    <span class="seo-dot miss">ثبت نشده</span>
                                }
                            </td>
                            <td>
                                <fa-num>@AudioKinds.FormatDuration(item.DurationSeconds)</fa-num>
                                @if (item.IsExternal)
                                {
                                    <span class="badge badge-wait" title="فایل روی سرور دیگری است">بیرونی</span>
                                }
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case PublishStatus.Published:
                                        <span class="badge badge-ok">منتشرشده</span>
                                        break;
                                    case PublishStatus.Archived:
                                        <span class="badge">بایگانی</span>
                                        break;
                                    default:
                                        <span class="badge badge-draft">پیش‌نویس</span>
                                        break;
                                }
                                @if (item.IsFeatured)
                                {
                                    <span class="badge badge-wait">صفحه اصلی</span>
                                }
                                @if (item.DownloadAccess == DownloadAccess.Disabled)
                                {
                                    <span class="badge badge-wait" title="فقط پخش آنلاین">بدون دانلود</span>
                                }
                                else if (item.DownloadAccess == DownloadAccess.SignedIn)
                                {
                                    <span class="badge badge-wait" title="دانلود فقط برای کاربران واردشده">دانلود محدود</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="actions">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="icon-btn" title="ویرایش">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                    </a>

                                    <form method="post" asp-page-handler="Feature" asp-route-id="@item.Id"
                                          asp-route-q="@Model.Q" asp-route-kind="@Model.Kind"
                                          asp-route-status="@Model.Status" asp-route-speakerId="@Model.SpeakerId"
                                          asp-route-seriesId="@Model.SeriesId" asp-route-safhe="@Model.PageNumber">
                                        <button type="submit" class="icon-btn @(item.IsFeatured ? "on" : "")"
                                                title="@(item.IsFeatured ? "برداشتن از صفحه اصلی" : "نمایش در صفحه اصلی")">
                                            <svg viewBox="0 0 24 24" fill="@(item.IsFeatured ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.8"><path d="m12 3 2.7 5.8 6.3.8-4.6 4.4 1.2 6.3L12 17.3 6.4 20.3l1.2-6.3L3 9.6l6.3-.8Z" /></svg>
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@item.Id"
                                          asp-route-q="@Model.Q" asp-route-kind="@Model.Kind"
                                          asp-route-status="@Model.Status" asp-route-speakerId="@Model.SpeakerId"
                                          asp-route-seriesId="@Model.SeriesId" asp-route-safhe="@Model.PageNumber">
                                        <button type="submit" class="icon-btn"
                                                title="@(item.Status == PublishStatus.Published ? "برگرداندن به پیش‌نویس" : "انتشار")">
                                            @if (item.Status == PublishStatus.Published)
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.6-7 10-7c2 0 3.7.7 5.1 1.6M22 12s-3.6 7-10 7c-2 0-3.7-.7-5.1-1.6" /><path d="M3 3l18 18" /></svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6 9 17l-5-5" /></svg>
                                            }
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"
                                          asp-route-q="@Model.Q" asp-route-kind="@Model.Kind"
                                          asp-route-status="@Model.Status" asp-route-speakerId="@Model.SpeakerId"
                                          asp-route-seriesId="@Model.SeriesId" asp-route-safhe="@Model.PageNumber"
                                          data-confirm="«@item.Title» حذف شود؟">
                                        <button type="submit" class="icon-btn danger" title="حذف">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pager" aria-label="صفحه‌بندی">
                @foreach (var p in Model.PagerPages)
                {
                    @if (p is null)
                    {
                        <span class="pager-gap" aria-hidden="true">…</span>
                    }
                    else
                    {
                        <a asp-page="./Index" asp-route-q="@Model.Q" asp-route-kind="@Model.Kind"
                           asp-route-status="@Model.Status" asp-route-speakerId="@Model.SpeakerId"
                           asp-route-seriesId="@Model.SeriesId" asp-route-safhe="@p"
                           class="pager-item @(p == Model.PageNumber ? "on" : "")"
                           aria-current="@(p == Model.PageNumber ? "page" : null)">
                            <fa-num>@p</fa-num>
                        </a>
                    }
                }
            </nav>
        }
    }
</section>
