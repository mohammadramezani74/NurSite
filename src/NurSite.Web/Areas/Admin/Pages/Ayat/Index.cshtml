@page
@model NurSite.Web.Areas.Admin.Pages.Ayat.IndexModel
@{
    ViewData["Title"] = "آیات صفحه اصلی";
    ViewData["Subtitle"] = "آیاتی که در اسلایدر بالای سایت می‌چرخند";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

<div class="edit-cols">
    <div class="edit-main">
        <section class="panel">
            <header class="panel-head">
                <h2>
                    آیات
                    <span class="count"><fa-num>@Model.ActiveCount</fa-num> فعال از <fa-num>@Model.Verses.Count</fa-num></span>
                </h2>
            </header>

            <div class="panel-body" style="gap:10px">
                <p class="field-note">
                    آیات فعال هر هفت ثانیه در بالای صفحه اصلی عوض می‌شوند.
                    ترتیبشان با فلش‌ها قابل تغییر است.
                </p>
            </div>

            @if (Model.Verses.Count == 0)
            {
                <p class="empty">هنوز آیه‌ای ثبت نشده است.</p>
            }
            else
            {
                <ul class="row-list">
                    @foreach (var v in Model.Verses)
                    {
                        <li class="row verse-row @(v.IsActive ? "" : "is-off")">
                            <div class="row-main">
                                <p class="verse-arabic">@v.ArabicText</p>
                                <p class="verse-persian">@v.PersianText</p>
                                <p class="row-meta"><span>@v.Reference</span></p>
                            </div>

                            <div class="actions">
                                <form method="post" asp-page-handler="Move" asp-route-id="@v.Id" asp-route-direction="up">
                                    <button type="submit" class="icon-btn" title="یک پله بالا">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 15-6-6-6 6" /></svg>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Move" asp-route-id="@v.Id" asp-route-direction="down">
                                    <button type="submit" class="icon-btn" title="یک پله پایین">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                                    </button>
                                </form>

                                <form method="post" asp-page-handler="Toggle" asp-route-id="@v.Id">
                                    <button type="submit" class="icon-btn @(v.IsActive ? "on" : "")"
                                            title="@(v.IsActive ? "غیرفعال کردن" : "فعال کردن")">
                                        @if (v.IsActive)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.6-7 10-7c2 0 3.7.7 5.1 1.6M22 12s-3.6 7-10 7c-2 0-3.7-.7-5.1-1.6" /><path d="M3 3l18 18" /></svg>
                                        }
                                    </button>
                                </form>

                                <a asp-page="./Index" asp-route-edit="@v.Id" class="icon-btn" title="ویرایش">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                </a>

                                <form method="post" asp-page-handler="Delete" asp-route-id="@v.Id"
                                      data-confirm="این آیه حذف شود؟">
                                    <button type="submit" class="icon-btn danger" title="حذف">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <aside class="edit-side">
        <form method="post">
            <input type="hidden" asp-for="Input.Id" />
            <section class="panel">
                <header class="panel-head">
                    <h2>@(Model.Input.Id == 0 ? "آیه تازه" : "ویرایش آیه")</h2>
                </header>
                <div class="panel-body">
                    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                    <div class="field">
                        <label asp-for="Input.ArabicText" class="label">
                            متن عربی
                            <span class="label-hint">با اعراب، اگر دارید</span>
                        </label>
                        <textarea asp-for="Input.ArabicText" class="input input-plain verse-input" rows="2"
                                  maxlength="500" placeholder="أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ"></textarea>
                        <span asp-validation-for="Input.ArabicText" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.PersianText" class="label">ترجمه فارسی</label>
                        <textarea asp-for="Input.PersianText" class="input input-plain" rows="2"
                                  maxlength="500" placeholder="آگاه باشید که دل‌ها تنها با یاد خدا آرام می‌گیرد"></textarea>
                        <span asp-validation-for="Input.PersianText" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Reference" class="label">منبع</label>
                        <input asp-for="Input.Reference" class="input input-plain"
                               placeholder="سوره رعد · آیه ۲۸" />
                        <span asp-validation-for="Input.Reference" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.SortOrder" class="label">ترتیب</label>
                        <input asp-for="Input.SortOrder" class="input input-plain" type="number" min="0" max="999" />
                    </div>

                    <label class="checkbox">
                        <input asp-for="Input.IsActive" type="checkbox" />
                        <span>در اسلایدر نمایش داده شود</span>
                    </label>

                    <div class="side-actions">
                        <button type="submit" class="btn btn-gold auth-submit">
                            @(Model.Input.Id == 0 ? "افزودن" : "ذخیره")
                        </button>
                        @if (Model.Input.Id != 0)
                        {
                            <a asp-page="./Index" class="btn btn-ghost auth-submit">انصراف</a>
                        }
                    </div>
                </div>
            </section>
        </form>
    </aside>
</div>
