@page
@model NurSite.Web.Areas.Admin.Pages.Abvab.IndexModel
@{
    ViewData["Title"] = "ابواب احکام";
    ViewData["Subtitle"] = "دسته‌بندی موضوعی احکام";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

<div class="edit-cols">
    <div class="edit-main">
        <section class="panel">
            <header class="panel-head">
                <h2>ابواب <span class="count"><fa-num>@Model.Rows.Count</fa-num></span></h2>
            </header>

            @if (Model.Rows.Count == 0)
            {
                <p class="empty">هنوز بابی تعریف نشده است. از فرم کنار شروع کنید.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>عنوان</th>
                                <th>احکام</th>
                                <th>ترتیب</th>
                                <th class="cell-actions">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td class="cell-title">
                                        <a asp-page="./Index" asp-route-edit="@row.Category.Id">@row.Category.Title</a>
                                        <span class="cell-slug">/ahkam/bab/@row.Category.Slug</span>
                                    </td>
                                    <td>
                                        @if (row.RulingCount > 0)
                                        {
                                            <a asp-area="Admin" asp-page="/Ahkam/Index" asp-route-categoryId="@row.Category.Id" class="badge badge-ok">
                                                <fa-num>@row.RulingCount</fa-num> حکم
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge badge-draft">خالی</span>
                                        }
                                    </td>
                                    <td><fa-num>@row.Category.SortOrder</fa-num></td>
                                    <td class="cell-actions">
                                        <div class="actions">
                                            <a asp-page="./Index" asp-route-edit="@row.Category.Id" class="icon-btn" title="ویرایش">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@row.Category.Id"
                                                  data-confirm="باب «@row.Category.Title» حذف شود؟">
                                                <button type="submit" class="icon-btn danger" title="حذف">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <aside class="edit-side">
        <form method="post">
            <input type="hidden" asp-for="Input.Id" />
            <section class="panel">
                <header class="panel-head">
                    <h2>@(Model.Input.Id == 0 ? "باب تازه" : "ویرایش باب")</h2>
                </header>
                <div class="panel-body">
                    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                    <div class="field">
                        <label asp-for="Input.Title" class="label">عنوان</label>
                        <input asp-for="Input.Title" class="input input-plain" placeholder="مثلاً: نماز" />
                        <span asp-validation-for="Input.Title" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Slug" class="label">
                            نشانی
                            <span class="label-hint">خالی بماند از عنوان ساخته می‌شود</span>
                        </label>
                        <input asp-for="Input.Slug" class="input input-plain" dir="ltr" />
                    </div>

                    <div class="field">
                        <label asp-for="Input.Description" class="label">توضیح</label>
                        <textarea asp-for="Input.Description" class="input input-plain" rows="3" maxlength="500"></textarea>
                    </div>

                    <div class="field">
                        <label asp-for="Input.SortOrder" class="label">ترتیب</label>
                        <input asp-for="Input.SortOrder" class="input input-plain" type="number" min="0" max="999" />
                    </div>

                    <div class="side-actions">
                        <button type="submit" class="btn btn-gold auth-submit">
                            @(Model.Input.Id == 0 ? "افزودن" : "ذخیره")
                        </button>
                        @if (Model.Input.Id != 0)
                        {
                            <a asp-page="./Index" class="btn btn-ghost auth-submit">انصراف</a>
                        }
                    </div>
                </div>
            </section>
        </form>
    </aside>
</div>
