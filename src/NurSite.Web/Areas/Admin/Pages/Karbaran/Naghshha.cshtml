@page
@model NurSite.Web.Areas.Admin.Pages.Karbaran.NaghshhaModel
@{
    ViewData["Title"] = "نقش‌ها و دسترسی‌ها";
    ViewData["Subtitle"] = "هر نقش به کدام بخش‌های پنل راه دارد";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

<div class="edit-cols">
    <div class="edit-main">
        <section class="panel">
            <header class="panel-head">
                <h2>نقش‌ها <span class="count"><fa-num>@Model.Rows.Count</fa-num></span></h2>
                <a asp-page="./Index" class="link-quiet">فهرست کاربران</a>
            </header>

            <div class="table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>نقش</th>
                            <th>کاربران</th>
                            <th>دسترسی‌ها</th>
                            <th class="cell-actions">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="cell-title">
                                    <a asp-page="./Naghshha" asp-route-edit="@row.Role.Name">@row.Role.DisplayName</a>
                                    <span class="cell-slug">@row.Role.Description</span>
                                </td>
                                <td>
                                    @if (row.UserCount > 0)
                                    {
                                        <a asp-page="./Index" asp-route-role="@row.Role.Name" class="badge badge-ok">
                                            <fa-num>@row.UserCount</fa-num> کاربر
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-draft">بدون کاربر</span>
                                    }
                                </td>
                                <td>
                                    @if (row.Permissions.Count == 0)
                                    {
                                        <span class="seo-dot miss">بدون دسترسی به پنل</span>
                                    }
                                    else
                                    {
                                        <span class="badge"><fa-num>@row.Permissions.Count</fa-num> از <fa-num>@NurSite.Infrastructure.Identity.Permissions.All().Count()</fa-num></span>
                                    }
                                </td>
                                <td class="cell-actions">
                                    <div class="actions">
                                        <a asp-page="./Naghshha" asp-route-edit="@row.Role.Name" class="icon-btn" title="ویرایش دسترسی‌ها">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="label-hint" style="padding:0 1.2rem 1.2rem">
                نقش‌ها ثابت‌اند و ساخته یا حذف نمی‌شوند؛ فقط دسترسی‌هایشان قابل تغییر است.
                کسی که هیچ دسترسی‌ای نداشته باشد اصلاً وارد پنل نمی‌شود.
            </p>
        </section>
    </div>

    <aside class="edit-side">
        @if (Model.Editing is null)
        {
            <section class="panel">
                <header class="panel-head"><h2>ویرایش دسترسی</h2></header>
                <div class="panel-body">
                    <p class="empty">برای تغییر دسترسی‌ها، یکی از نقش‌های کنار را انتخاب کنید.</p>
                </div>
            </section>
        }
        else
        {
            <form method="post">
                <input type="hidden" asp-for="RoleName" />
                <section class="panel">
                    <header class="panel-head">
                        <h2>@Model.Editing.DisplayName</h2>
                        <a asp-page="./Naghshha" class="link-quiet">انصراف</a>
                    </header>
                    <div class="panel-body">
                        @if (Model.Editing.Name == NurSite.Infrastructure.Identity.AppRoles.SuperAdmin)
                        {
                            <div class="flash flash-warn" style="margin:0 0 1rem">
                                مدیر ارشد نقش پشتیبان سایت است. برداشتن دسترسی‌هایش
                                می‌تواند شما را از پنل بیرون بگذارد.
                            </div>
                        }

                        @foreach (var group in NurSite.Web.Areas.Admin.Pages.Karbaran.NaghshhaModel.Groups)
                        {
                            <p class="nav-group" style="margin-top:1rem">@group.Key</p>

                            @foreach (var permission in group)
                            {
                                <label class="checkbox">
                                    <input type="checkbox" name="Selected" value="@permission"
                                           checked="@(Model.Selected.Contains(permission))" />
                                    <span>
                                        @NurSite.Web.Areas.Admin.Pages.Karbaran.NaghshhaModel.Title(permission)
                                        @{
                                            var hint = NurSite.Web.Areas.Admin.Pages.Karbaran.NaghshhaModel.Hint(permission);
                                        }
                                        @if (!string.IsNullOrEmpty(hint))
                                        {
                                            <span class="label-hint">@hint</span>
                                        }
                                    </span>
                                </label>
                            }
                        }

                        <div class="side-actions">
                            <button type="submit" class="btn btn-gold auth-submit">ذخیره دسترسی‌ها</button>
                        </div>

                        <p class="label-hint" style="margin-top:.8rem">
                            بعد از ذخیره، کاربران این نقش باید دوباره وارد شوند تا
                            دسترسی تازه اعمال شود.
                        </p>
                    </div>
                </section>
            </form>
        }
    </aside>
</div>
