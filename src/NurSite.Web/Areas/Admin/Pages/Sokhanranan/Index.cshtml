@page
@model NurSite.Web.Areas.Admin.Pages.Sokhanranan.IndexModel
@{
    ViewData["Title"] = "سخنرانان";
    ViewData["Subtitle"] = "استادان و سخنرانانی که صوتشان در سایت هست";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

<div class="edit-cols">
    <div class="edit-main">
        <section class="panel">
            <header class="panel-head">
                <h2>سخنرانان <span class="count"><fa-num>@Model.Rows.Count</fa-num></span></h2>
            </header>

            @if (Model.Rows.Count == 0)
            {
                <p class="empty">هنوز سخنرانی ثبت نشده است. از فرم کنار شروع کنید.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>نام</th>
                                <th>سخنرانی‌ها</th>
                                <th>وضعیت</th>
                                <th class="cell-actions">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                var s = row.Speaker;
                                <tr>
                                    <td class="cell-title">
                                        <a asp-page="./Index" asp-route-edit="@s.Id">@s.FullName</a>
                                        <span class="cell-slug">
                                            @if (!string.IsNullOrWhiteSpace(s.Title))
                                            {
                                                <text>@s.Title · </text>
                                            }
                                            /sokhanraniha/sokhanran/@s.Slug
                                        </span>
                                    </td>
                                    <td>
                                        @if (row.LectureCount > 0)
                                        {
                                            <span class="badge badge-ok">
                                                <fa-num>@row.PublishedCount</fa-num> از <fa-num>@row.LectureCount</fa-num> منتشرشده
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-draft">خالی</span>
                                        }
                                    </td>
                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <span class="badge badge-ok">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge">غیرفعال</span>
                                        }
                                    </td>
                                    <td class="cell-actions">
                                        <div class="actions">
                                            <a asp-page="./Index" asp-route-edit="@s.Id" class="icon-btn" title="ویرایش">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id"
                                                  data-confirm="«@s.FullName» حذف شود؟">
                                                <button type="submit" class="icon-btn danger" title="حذف">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <aside class="edit-side">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.PortraitPath" />
            <section class="panel">
                <header class="panel-head">
                    <h2>@(Model.Input.Id == 0 ? "سخنران تازه" : "ویرایش سخنران")</h2>
                </header>
                <div class="panel-body">
                    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                    <div class="field">
                        <label asp-for="Input.FullName" class="label">نام کامل</label>
                        <input asp-for="Input.FullName" class="input input-plain"
                               placeholder="مثلاً: حجت‌الاسلام محمدرضا احمدی" />
                        <span asp-validation-for="Input.FullName" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Title" class="label">
                            عنوان
                            <span class="label-hint">زیر نام نمایش داده می‌شود</span>
                        </label>
                        <input asp-for="Input.Title" class="input input-plain"
                               placeholder="مثلاً: استاد حوزه علمیه قم" />
                    </div>

                    <div class="field">
                        <label asp-for="PortraitFile" class="label">
                            تصویر
                            <span class="label-hint">مربعی بهتر است</span>
                        </label>
                        @if (!string.IsNullOrWhiteSpace(Model.Input.PortraitPath))
                        {
                            <img src="@Model.Input.PortraitPath" alt="تصویر @Model.Input.FullName"
                                 style="width:72px;height:72px;object-fit:cover;border-radius:50%;margin-bottom:.5rem" />
                        }
                        <input asp-for="PortraitFile" type="file" accept="image/*" class="input input-plain" />
                        <span asp-validation-for="PortraitFile" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Bio" class="label">
                            معرفی
                            <span class="label-hint">در صفحه سخنران می‌آید</span>
                        </label>
                        <textarea asp-for="Input.Bio" class="input input-plain" rows="4"></textarea>
                    </div>

                    <details class="more-fields">
                        <summary>اطلاعات بیشتر</summary>
                        <div class="field">
                            <label asp-for="Input.Slug" class="label">
                                نشانی
                                <span class="label-hint">خالی بماند از نام ساخته می‌شود</span>
                            </label>
                            <input asp-for="Input.Slug" class="input input-plain" />
                        </div>
                    </details>

                    <label class="checkbox">
                        <input asp-for="Input.IsActive" type="checkbox" />
                        <span>فعال</span>
                    </label>

                    <div class="side-actions">
                        <button type="submit" class="btn btn-gold auth-submit">
                            @(Model.Input.Id == 0 ? "افزودن" : "ذخیره")
                        </button>
                        @if (Model.Input.Id != 0)
                        {
                            <a asp-page="./Index" class="btn btn-ghost auth-submit">انصراف</a>
                        }
                    </div>
                </div>
            </section>
        </form>
    </aside>
</div>
