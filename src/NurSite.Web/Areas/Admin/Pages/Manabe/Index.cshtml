@page
@model NurSite.Web.Areas.Admin.Pages.Manabe.IndexModel
@{
    ViewData["Title"] = "منابع احکام";
    ViewData["Subtitle"] = "کتاب‌هایی که احکام از آنها وارد شده است";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

<div class="edit-cols">
    <div class="edit-main">
        <section class="panel">
            <header class="panel-head">
                <h2>منابع <span class="count"><fa-num>@Model.Rows.Count</fa-num></span></h2>
            </header>

            @if (Model.Rows.Count == 0)
            {
                <p class="empty">هنوز منبعی ثبت نشده است. از فرم کنار شروع کنید.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>کتاب</th>
                                <th>احکام</th>
                                <th>لینک</th>
                                <th>وضعیت</th>
                                <th class="cell-actions">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                var s = row.Source;
                                <tr>
                                    <td class="cell-title">
                                        <a asp-page="./Index" asp-route-edit="@s.Id">@s.Title</a>
                                        <span class="cell-slug">
                                            @if (!string.IsNullOrWhiteSpace(s.Author))
                                            {
                                                <text>@s.Author</text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(s.Publisher))
                                            {
                                                <text> · @s.Publisher</text>
                                            }
                                            @if (s.PublishedYear is not null)
                                            {
                                                <text> · <fa-num>@s.PublishedYear</fa-num></text>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        @if (row.RulingCount > 0)
                                        {
                                            <a asp-area="Admin" asp-page="/Ahkam/Index" class="badge badge-ok">
                                                <fa-num>@row.PublishedCount</fa-num> از <fa-num>@row.RulingCount</fa-num> منتشرشده
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge badge-draft">خالی</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(s.Url))
                                        {
                                            <a href="@s.Url" target="_blank" rel="noopener noreferrer nofollow"
                                               class="link-quiet" dir="ltr">معرفی کتاب</a>
                                        }
                                        else
                                        {
                                            <span class="seo-dot miss">ثبت نشده</span>
                                        }
                                    </td>
                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <span class="badge badge-ok">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge">غیرفعال</span>
                                        }
                                    </td>
                                    <td class="cell-actions">
                                        <div class="actions">
                                            <a asp-page="./Index" asp-route-edit="@s.Id" class="icon-btn" title="ویرایش">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id"
                                                  data-confirm="«@s.Title» حذف شود؟">
                                                <button type="submit" class="icon-btn danger" title="حذف">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <aside class="edit-side">
        <form method="post">
            <input type="hidden" asp-for="Input.Id" />
            <section class="panel">
                <header class="panel-head">
                    <h2>@(Model.Input.Id == 0 ? "منبع تازه" : "ویرایش منبع")</h2>
                </header>
                <div class="panel-body">
                    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                    <div class="field">
                        <label asp-for="Input.Title" class="label">عنوان کتاب</label>
                        <input asp-for="Input.Title" class="input input-plain" />
                        <span asp-validation-for="Input.Title" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Author" class="label">نویسنده</label>
                        <input asp-for="Input.Author" class="input input-plain" />
                    </div>

                    <div class="field">
                        <label asp-for="Input.Publisher" class="label">ناشر</label>
                        <input asp-for="Input.Publisher" class="input input-plain" />
                    </div>

                    <div class="field">
                        <label asp-for="Input.PublishedYear" class="label">سال انتشار</label>
                        <input asp-for="Input.PublishedYear" class="input input-plain" type="number" min="1300" max="1500" />
                        <span asp-validation-for="Input.PublishedYear" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Url" class="label">
                            نشانی معرفی کتاب
                            <span class="label-hint">در پایین هر حکم نمایش داده می‌شود</span>
                        </label>
                        <input asp-for="Input.Url" class="input input-plain" dir="ltr"
                               placeholder="https://" />
                        <span asp-validation-for="Input.Url" class="field-error"></span>
                    </div>

                    <details class="more-fields">
                        <summary>اطلاعات بیشتر</summary>

                        <div class="field">
                            <label asp-for="Input.Editor" class="label">ویراستار</label>
                            <input asp-for="Input.Editor" class="input input-plain" />
                        </div>

                        <div class="field">
                            <label asp-for="Input.Isbn" class="label">شابک</label>
                            <input asp-for="Input.Isbn" class="input input-plain" dir="ltr" />
                        </div>

                        <div class="field">
                            <label asp-for="Input.Edition" class="label">نوبت چاپ</label>
                            <input asp-for="Input.Edition" class="input input-plain" />
                        </div>

                        <div class="field">
                            <label asp-for="Input.Description" class="label">توضیح</label>
                            <textarea asp-for="Input.Description" class="input input-plain" rows="3"></textarea>
                        </div>

                        <div class="field">
                            <label asp-for="Input.PermissionNote" class="label">
                                یادداشت اجازه
                                <span class="label-hint">شرایطی که ناشر گذاشته است</span>
                            </label>
                            <textarea asp-for="Input.PermissionNote" class="input input-plain" rows="2"></textarea>
                        </div>

                        <div class="field">
                            <label asp-for="Input.SortOrder" class="label">ترتیب</label>
                            <input asp-for="Input.SortOrder" class="input input-plain" type="number" min="0" max="999" />
                        </div>
                    </details>

                    <label class="checkbox">
                        <input asp-for="Input.IsActive" type="checkbox" />
                        <span>فعال</span>
                    </label>

                    <div class="side-actions">
                        <button type="submit" class="btn btn-gold auth-submit">
                            @(Model.Input.Id == 0 ? "افزودن" : "ذخیره")
                        </button>
                        @if (Model.Input.Id != 0)
                        {
                            <a asp-page="./Index" class="btn btn-ghost auth-submit">انصراف</a>
                        }
                    </div>
                </div>
            </section>
        </form>
    </aside>
</div>
