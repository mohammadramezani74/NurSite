@page
@model NurSite.Web.Areas.Admin.Pages.Maghalat.IndexModel
@inject NurSite.Application.Interfaces.IPersianDateService Dates
@{
    ViewData["Title"] = "مقالات";
    ViewData["Subtitle"] = "نوشتن، ویرایش و انتشار مطالب";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash @(Model.FlashKind == "ok" ? "flash-ok" : "flash-warn")" role="status">@Model.Flash</div>
}

<section class="panel">
    <header class="panel-head">
        <h2>فهرست مقالات <span class="count"><fa-num>@Model.TotalCount</fa-num></span></h2>
        <a asp-page="./Edit" class="btn btn-gold btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px"><path d="M12 5v14M5 12h14" /></svg>
            مقاله تازه
        </a>
    </header>

    <form method="get" class="filter-bar">
        <div class="filter-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <label class="sr" for="q">جستجو در عنوان و خلاصه</label>
            <input id="q" name="q" value="@Model.Q" placeholder="جستجو در عنوان و خلاصه…" />
        </div>

        <label class="sr" for="status">وضعیت</label>
        <select id="status" name="status" class="filter-select">
            <option value="">همه وضعیت‌ها</option>
            <option value="@((int)PublishStatus.Draft)" selected="@(Model.Status == PublishStatus.Draft)">پیش‌نویس</option>
            <option value="@((int)PublishStatus.Published)" selected="@(Model.Status == PublishStatus.Published)">منتشرشده</option>
            <option value="@((int)PublishStatus.Archived)" selected="@(Model.Status == PublishStatus.Archived)">بایگانی</option>
        </select>

        <label class="sr" for="categoryId">دسته‌بندی</label>
        <select id="categoryId" name="categoryId" class="filter-select">
            <option value="">همه دسته‌ها</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Title</option>
            }
        </select>

        <button type="submit" class="btn btn-ghost btn-sm">اعمال</button>
        @if (!string.IsNullOrWhiteSpace(Model.Q) || Model.Status is not null || Model.CategoryId is not null)
        {
            <a asp-page="./Index" class="link-quiet">حذف فیلترها</a>
        }
    </form>

    @if (Model.Articles.Count == 0)
    {
        <p class="empty">
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <span>نتیجه‌ای برای «@Model.Q» پیدا نشد.</span>
            }
            else
            {
                <span>هنوز مقاله‌ای ثبت نشده است. با دکمه «مقاله تازه» شروع کنید.</span>
            }
        </p>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>عنوان</th>
                        <th>دسته</th>
                        <th>وضعیت</th>
                        <th>سئو</th>
                        <th>آخرین تغییر</th>
                        <th class="cell-actions">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Articles)
                    {
                        var seoOk = !string.IsNullOrWhiteSpace(a.MetaTitle)
                        && !string.IsNullOrWhiteSpace(a.MetaDescription)
                        && !string.IsNullOrWhiteSpace(a.CoverImageAlt);
                        <tr>
                            <td class="cell-title">
                                <a asp-page="./Edit" asp-route-id="@a.Id">@a.Title</a>
                                <span class="cell-slug">/maghalat/@a.Slug</span>
                            </td>
                            <td>@a.Category.Title</td>
                            <td>
                                @switch (a.Status)
                                {
                                    case PublishStatus.Published:
                                        <span class="badge badge-ok">منتشرشده</span>
                                        break;
                                    case PublishStatus.Archived:
                                        <span class="badge">بایگانی</span>
                                        break;
                                    default:
                                        <span class="badge badge-draft">پیش‌نویس</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (seoOk)
                                {
                                    <span class="seo-dot ok" title="متا و متن جایگزین تصویر کامل است">کامل</span>
                                }
                                else
                                {
                                    <span class="seo-dot miss" title="عنوان متا، توضیح متا یا متن جایگزین تصویر ناقص است">ناقص</span>
                                }
                            </td>
                            <td><persian-date value="@(a.UpdatedAtUtc ?? a.CreatedAtUtc)" /></td>
                            <td class="cell-actions">
                                <div class="actions">
                                    <a asp-page="./Edit" asp-route-id="@a.Id" class="icon-btn" title="ویرایش">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                    </a>

                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@a.Id"
                                          asp-route-q="@Model.Q" asp-route-safhe="@Model.PageNumber">
                                        <button type="submit" class="icon-btn"
                                                title="@(a.Status == PublishStatus.Published ? "برگرداندن به پیش‌نویس" : "انتشار")">
                                            @if (a.Status == PublishStatus.Published)
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.6-7 10-7c2 0 3.7.7 5.1 1.6M22 12s-3.6 7-10 7c-2 0-3.7-.7-5.1-1.6" /><path d="M3 3l18 18" /></svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6 9 17l-5-5" /></svg>
                                            }
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@a.Id"
                                          asp-route-q="@Model.Q" asp-route-safhe="@Model.PageNumber"
                                          data-confirm="مقاله «@a.Title» حذف شود؟">
                                        <button type="submit" class="icon-btn danger" title="حذف">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pager" aria-label="صفحه‌بندی">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-page="./Index"
                       asp-route-q="@Model.Q"
                       asp-route-status="@Model.Status"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-safhe="@p"
                       class="pager-item @(p == Model.PageNumber ? "on" : "")"
                       aria-current="@(p == Model.PageNumber ? "page" : null)">
                        <fa-num>@p</fa-num>
                    </a>
                }
            </nav>
        }
    }
</section>
