@inject NurSite.Application.Interfaces.IPersianDateService Dates
@{
    var request = ViewContext.HttpContext.Request;
    var nowUtc = DateTime.UtcNow;
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    bool IsCurrent(string page) =>
        current.Equals(page, StringComparison.OrdinalIgnoreCase);

    var displayName = User.Identity?.Name ?? "";
    var roleLabel = User.IsInRole(AppRoles.SuperAdmin) ? "مدیر ارشد"
                  : User.IsInRole(AppRoles.Admin) ? "مدیر"
                  : User.IsInRole(AppRoles.Editor) ? "ویراستار"
                  : User.IsInRole(AppRoles.Mufti) ? "پاسخگوی شرعی"
                  : "کاربر";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="lajvard">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] — پنل مدیریت</title>

    @* پنل هرگز نباید ایندکس شود *@
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#04121F">

    <link rel="preload" href="~/fonts/Vazirmatn-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="~/fonts/Vazirmatn-Bold.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="admin-body">

    <a class="skip-link" href="#adminMain">پرش به محتوای اصلی</a>

    <div class="admin-shell">

        <!-- ================= نوار کناری ================= -->
        <aside class="admin-side" id="adminSide">
            <div class="admin-brand">
                <span class="logo-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19" /></svg>
                </span>
                <span><b>نورالثقلین</b><small>پنل مدیریت</small></span>
            </div>

            <nav class="admin-nav" aria-label="فهرست پنل">

                <p class="nav-group">کلی</p>
                <a asp-area="Admin" asp-page="/Index" class="nav-item @(IsCurrent("/Index") ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="9" /><rect x="14" y="3" width="7" height="5" /><rect x="14" y="12" width="7" height="9" /><rect x="3" y="16" width="7" height="5" /></svg>
                    داشبورد
                </a>

                <p class="nav-group">محتوا</p>
                <a asp-area="Admin" asp-page="/Maghalat/Index" class="nav-item @(current.StartsWith("/Maghalat", StringComparison.OrdinalIgnoreCase) ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 19V6a2 2 0 0 1 2-2h11v16H6a2 2 0 0 0-2 2Z" /><path d="M9 8h5" /></svg>
                    مقالات
                </a>
                <a asp-area="Admin" asp-page="/Dastebandi/Index" class="nav-item @(current.StartsWith("/Dastebandi", StringComparison.OrdinalIgnoreCase) ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h6l2 2h10v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" /></svg>
                    دسته‌بندی‌ها
                </a>
                <a asp-area="Admin" asp-page="/Ahkam/Index" class="nav-item @(current.StartsWith("/Ahkam", StringComparison.OrdinalIgnoreCase) ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" /></svg>
                    احکام
                </a>
                <a asp-area="Admin" asp-page="/Abvab/Index" class="nav-item @(current.StartsWith("/Abvab", StringComparison.OrdinalIgnoreCase) ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 19V6a2 2 0 0 1 2-2h11v16H6a2 2 0 0 0-2 2Z" /><path d="M9 12h5M9 8h5" /></svg>
                    ابواب احکام
                </a>
                <a asp-area="Admin" asp-page="/Maraje/Index" class="nav-item @(current.StartsWith("/Maraje", StringComparison.OrdinalIgnoreCase) ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3 3 8v2h18V8Z" /><path d="M5 10v8M9 10v8M15 10v8M19 10v8M3 20h18" /></svg>
                    مراجع تقلید
                </a>
                <a href="#" class="nav-item soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                    سخنرانی‌ها
                </a>
                <a href="#" class="nav-item soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                    برنامه‌ها
                </a>
                <a href="#" class="nav-item soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                    گالری
                </a>

                <p class="nav-group">ارتباطات</p>
                <a asp-area="Admin" asp-page="/Porseshha/Index" class="nav-item @(current.StartsWith("/Porseshha", StringComparison.OrdinalIgnoreCase) ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.6 2.6 0 0 1 5 .9c0 1.7-2.5 2.6-2.5 2.6M12 17h.01" /></svg>
                    پرسش‌های شرعی
                </a>
                <a href="#" class="nav-item soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                    پیام‌های تماس
                </a>
                <a href="#" class="nav-item soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg>
                    خبرنامه
                </a>

                <p class="nav-group">سیستم</p>
                <a href="#" class="nav-item soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9.5" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /></svg>
                    کاربران
                </a>
                <a asp-area="Admin" asp-page="/TaghvimGhamari/Index" class="nav-item @(current.StartsWith("/TaghvimGhamari", StringComparison.OrdinalIgnoreCase) ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /><circle cx="12" cy="15" r="2" /></svg>
                    تقویم قمری
                </a>
                <a asp-area="Admin" asp-page="/Tanzimat/Index" class="nav-item @(current.StartsWith("/Tanzimat", StringComparison.OrdinalIgnoreCase) ? "on" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.09A1.65 1.65 0 0 0 10.6 3.09V3a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 15 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.09A1.65 1.65 0 0 0 21 10.6H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" /></svg>
                    تنظیمات سایت
                </a>
            </nav>

            <div class="admin-side-foot">
                <a asp-area="" asp-page="/Index" class="nav-item quiet" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><path d="M15 3h6v6M10 14 21 3" /></svg>
                    مشاهده سایت
                </a>
            </div>
        </aside>

        <div class="admin-overlay" id="adminOverlay" hidden></div>

        <!-- ================= بخش اصلی ================= -->
        <div class="admin-main">

            <header class="admin-top">
                <button class="admin-burger" id="adminBurger" aria-label="باز کردن فهرست" aria-expanded="false" aria-controls="adminSide">
                    <span></span>
                </button>

                <div class="admin-title">
                    <h1>@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string sub && !string.IsNullOrWhiteSpace(sub))
                    {
                        <p>@sub</p>
                    }
                </div>

                <div class="admin-top-side">
                    <span class="admin-date">@Dates.ToPersianDate(nowUtc, includeWeekday: true)</span>

                    <div class="admin-user">
                        <span class="admin-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </span>
                        <span class="admin-user-text">
                            <bdi>@Dates.ToPersianDigits(displayName)</bdi>
                            <small>@roleLabel</small>
                        </span>
                    </div>

                    <form asp-area="" asp-page="/Khorooj" method="post">
                        <button type="submit" class="btn btn-ghost btn-sm">خروج</button>
                    </form>
                </div>
            </header>

            <main class="admin-content" id="adminMain">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/admin.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
